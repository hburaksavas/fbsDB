<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FbsDb.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FbsDb"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0C1118">
        <WebView2
            x:Name="EditorWebView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DefaultBackgroundColor="#0C1118" />
        <Grid x:Name="StartupOverlay" Background="#091118">
            <Border Width="640" Height="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#091118" BorderBrush="#65727B" BorderThickness="1" CornerRadius="7">
                <Grid Margin="37,30,37,27">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="StartupBrand" Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="#102521"
                                BorderBrush="#167968" BorderThickness="1">
                            <Image Width="34" Height="34" Source="Assets/Square44x44Logo.scale-200.png" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <Run Text="fbs" Foreground="#E6EDF4" /><Run Text="DB" Foreground="#40D5B8" />
                            </TextBlock>
                            <TextBlock Text="Oracle SQL workbench" Foreground="#8EA0B4" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="10,5" VerticalAlignment="Center" CornerRadius="12"
                                Background="#0B141C" BorderBrush="#263645" BorderThickness="1">
                            <TextBlock Text="v 0.1.0" Foreground="#A7B6C8" FontSize="9" FontFamily="Cascadia Code" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,22,0,12" ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="15">
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="WorkspaceStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="WorkspaceStepPending" Stroke="#314252" StrokeThickness="1" />
                                    <Ellipse x:Name="WorkspaceStepDone" Fill="#37D4B6" Visibility="Collapsed" />
                                    <TextBlock x:Name="WorkspaceStepCheck" Text="✓" Foreground="#071714" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="WorkspaceStepRunning" IsActive="True" Foreground="#38D6B8" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="WorkspaceStepLabel" Grid.Column="1" Text="Reading workspace settings" Foreground="#9AAFC3" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="WorkspaceStepState" Grid.Column="2" Text="" Foreground="#42D7B8" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="ConnectionsStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnectionsStepPending" Stroke="#314252" StrokeThickness="1" />
                                    <Ellipse x:Name="ConnectionsStepDone" Fill="#37D4B6" Visibility="Collapsed" />
                                    <TextBlock x:Name="ConnectionsStepCheck" Text="✓" Foreground="#071714" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="ConnectionsStepRunning" IsActive="True" Foreground="#38D6B8" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="ConnectionsStepLabel" Grid.Column="1" Text="Loading saved connections" Foreground="#9AAFC3" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionsStepState" Grid.Column="2" Foreground="#42D7B8" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="EditorStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="EditorStepPending" Stroke="#314252" StrokeThickness="1" />
                                    <Ellipse x:Name="EditorStepDone" Fill="#37D4B6" Visibility="Collapsed" />
                                    <TextBlock x:Name="EditorStepCheck" Text="✓" Foreground="#071714" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="EditorStepRunning" IsActive="True" Foreground="#38D6B8" />
                                </Grid>
                                <TextBlock x:Name="EditorStepLabel" Grid.Column="1" Text="Starting SQL editor" Foreground="#F2F5F8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="EditorStepState" Grid.Column="2" Text="RUNNING" Foreground="#42D7B8" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="DriverStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="DriverStepPending" Stroke="#314252" StrokeThickness="1" />
                                    <Ellipse x:Name="DriverStepDone" Fill="#37D4B6" Visibility="Collapsed" />
                                    <TextBlock x:Name="DriverStepCheck" Text="✓" Foreground="#071714" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="DriverStepRunning" IsActive="True" Foreground="#38D6B8" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="DriverStepLabel" Grid.Column="1" Text="Preparing Oracle driver" Foreground="#9AAFC3" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="DriverStepState" Grid.Column="2" Foreground="#42D7B8" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="StartupDatabase" Grid.Column="1" Width="188" Height="232" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.72">
                            <Border CornerRadius="46" BorderBrush="#182833" BorderThickness="1" />
                            <Ellipse Height="68" VerticalAlignment="Top" Stroke="#182833" StrokeThickness="1" />
                            <Ellipse Height="68" Margin="0,54,0,0" VerticalAlignment="Top" Stroke="#182833" StrokeThickness="1" />
                            <Ellipse Height="68" Margin="0,112,0,0" VerticalAlignment="Top" Stroke="#182833" StrokeThickness="1" />
                            <Ellipse Height="68" VerticalAlignment="Bottom" Stroke="#182833" StrokeThickness="1" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartupStatus" Text="Starting SQL editor…" Foreground="#D7E2EE" FontSize="10" FontFamily="Cascadia Code" />
                            <TextBlock x:Name="StartupPercent" Grid.Column="1" Text="64%" Foreground="#42D7B8" FontSize="10" FontFamily="Cascadia Code" />
                        </Grid>
                        <ProgressBar x:Name="StartupProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="64"
                                     Height="4" Foreground="#39D6B7" Background="#17232D" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock
            x:Name="EditorError"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="720"
            TextWrapping="Wrap"
            Foreground="#D8E1EE"
            FontSize="14" />
    </Grid>
</Page>
