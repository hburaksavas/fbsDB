<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FbsDb.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FbsDb"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ShellBackgroundBrush}">
        <WebView2
            x:Name="EditorWebView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DefaultBackgroundColor="{ThemeResource ShellBackgroundColor}" />
        <Grid x:Name="StartupOverlay" Background="{ThemeResource ShellBackgroundBrush}">
            <Border Width="640" Height="400"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource ShellBackgroundBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid Margin="37,30,37,27">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="StartupBrand" Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource ShellInputBrush}"
                                BorderBrush="{ThemeResource ShellAccentBrush}" BorderThickness="1">
                            <Image Width="34" Height="34" Source="Assets/Square44x44Logo.scale-200.png" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <Run Text="fbs" Foreground="{ThemeResource ShellTextBrush}" /><Run Text="DB" Foreground="{ThemeResource ShellAccentBrush}" />
                            </TextBlock>
                            <TextBlock Text="Oracle SQL workbench" Foreground="{ThemeResource ShellMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="10,5" VerticalAlignment="Center" CornerRadius="12"
                                Background="{ThemeResource ShellInputBrush}" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="1">
                            <TextBlock Text="v 0.1.0" Foreground="{ThemeResource ShellMutedBrush}" FontSize="9" FontFamily="Cascadia Code" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,22,0,12" ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="15">
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="WorkspaceStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="WorkspaceStepPending" Stroke="{ThemeResource ShellBorderBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="WorkspaceStepDone" Fill="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="WorkspaceStepCheck" Text="✓" Foreground="{ThemeResource ShellOnAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="WorkspaceStepRunning" IsActive="True" Foreground="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="WorkspaceStepLabel" Grid.Column="1" Text="Reading workspace settings" Foreground="{ThemeResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="WorkspaceStepState" Grid.Column="2" Text="" Foreground="{ThemeResource ShellAccentBrush}" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="ConnectionsStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnectionsStepPending" Stroke="{ThemeResource ShellBorderBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="ConnectionsStepDone" Fill="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="ConnectionsStepCheck" Text="✓" Foreground="{ThemeResource ShellOnAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="ConnectionsStepRunning" IsActive="True" Foreground="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="ConnectionsStepLabel" Grid.Column="1" Text="Loading saved connections" Foreground="{ThemeResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionsStepState" Grid.Column="2" Foreground="{ThemeResource ShellAccentBrush}" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="EditorStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="EditorStepPending" Stroke="{ThemeResource ShellBorderBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="EditorStepDone" Fill="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="EditorStepCheck" Text="✓" Foreground="{ThemeResource ShellOnAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="EditorStepRunning" IsActive="True" Foreground="{ThemeResource ShellAccentBrush}" />
                                </Grid>
                                <TextBlock x:Name="EditorStepLabel" Grid.Column="1" Text="Starting SQL editor" Foreground="{ThemeResource ShellAccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="EditorStepState" Grid.Column="2" Text="RUNNING" Foreground="{ThemeResource ShellAccentBrush}" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Height="20" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                                <Grid x:Name="DriverStepMarker" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="DriverStepPending" Stroke="{ThemeResource ShellBorderBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="DriverStepDone" Fill="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="DriverStepCheck" Text="✓" Foreground="{ThemeResource ShellOnAccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ProgressRing x:Name="DriverStepRunning" IsActive="True" Foreground="{ThemeResource ShellAccentBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="DriverStepLabel" Grid.Column="1" Text="Preparing Oracle driver" Foreground="{ThemeResource ShellMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="DriverStepState" Grid.Column="2" Foreground="{ThemeResource ShellAccentBrush}" FontSize="8" FontFamily="Cascadia Code" CharacterSpacing="120" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="StartupDatabase" Grid.Column="1" Width="188" Height="232" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.72">
                            <Border CornerRadius="46" BorderBrush="{ThemeResource ShellAccentBrush}" BorderThickness="1" />
                            <Ellipse Height="68" VerticalAlignment="Top" Stroke="{ThemeResource ShellAccentBrush}" StrokeThickness="1" />
                            <Ellipse Height="68" Margin="0,54,0,0" VerticalAlignment="Top" Stroke="{ThemeResource ShellAccentBrush}" StrokeThickness="1" />
                            <Ellipse Height="68" Margin="0,112,0,0" VerticalAlignment="Top" Stroke="{ThemeResource ShellAccentBrush}" StrokeThickness="1" />
                            <Ellipse Height="68" VerticalAlignment="Bottom" Stroke="{ThemeResource ShellAccentBrush}" StrokeThickness="1" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartupStatus" Text="Starting SQL editor…" Foreground="{ThemeResource ShellAccentBrush}" FontSize="10" FontFamily="Cascadia Code" />
                            <TextBlock x:Name="StartupPercent" Grid.Column="1" Text="64%" Foreground="{ThemeResource ShellAccentBrush}" FontSize="10" FontFamily="Cascadia Code" />
                        </Grid>
                        <ProgressBar x:Name="StartupProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="64"
                                     Height="4" Foreground="{ThemeResource ShellAccentBrush}" Background="{ThemeResource ShellAccentBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border
            x:Name="EditorErrorPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="560" Margin="24" Padding="20" CornerRadius="8"
            BorderThickness="1" BorderBrush="{ThemeResource ShellBorderBrush}"
            Background="{ThemeResource ShellSurfaceBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="Unable to open the SQL workbench" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource ShellTextBrush}" />
                <TextBlock x:Name="EditorError" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource ShellMutedBrush}" FontSize="12"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
