{
  "name": "fbsdb",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prebuild": "npm run check:bridge && node scripts/generate/generate-theme-tokens.mjs",
    "predev": "node scripts/generate/generate-theme-tokens.mjs",
    "generate:bridge": "node scripts/generate/generate-bridge-contract.mjs",
    "check:bridge": "node scripts/generate/generate-bridge-contract.mjs --check",
    "typecheck:bridge": "tsc -p tsconfig.bridge.json",
    "test": "node scripts/test/test-unit.mjs",
    "test:load": "node scripts/test/test-load.mjs",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test/test-desktop.ps1",
    "clean:test-output": "node scripts/test/clean-test-output.mjs",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "check:names": "node scripts/check/check-names.mjs",
    "test:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test/test-release.ps1"
  },
  "dependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^1.61.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
